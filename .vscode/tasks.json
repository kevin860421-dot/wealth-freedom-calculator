{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git: 推送到 GitHub (main)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/push-to-github.ps1",
        "-Message",
        "${input:gitCommitMessage}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Git: 推送前先 pull --rebase",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/push-to-github.ps1",
        "-Pull",
        "-Message",
        "${input:gitCommitMessage}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    }
  ],
  "inputs": [
    {
      "id": "gitCommitMessage",
      "type": "promptString",
      "description": "Commit 訊息（可直接 Enter 使用預設時間戳）",
      "default": ""
    }
  ]
}
