# 頁尾「回饋寄信」顯示用（公開給瀏覽器，勿放密碼）
NEXT_PUBLIC_CONTACT_EMAIL=

# quick-11 第四步：粉專（Messenger 私訊可改 https://m.me/wealth.freedom.calculator）
NEXT_PUBLIC_FB_PAGE_URL=https://www.facebook.com/wealth.freedom.calculator

# 僅在本機 npm run dev 時生效：忽略部落格 publishAtIso，方便預覽列表與全文（正式部署 production 不會套用）
# NEXT_PUBLIC_BLOG_PREVIEW_ALL=true

# ── GameFi Phase 1A：Supabase PostgreSQL + Auth ──
# Supabase → Project Settings → Database
# Runtime（Vercel）：Transaction pooler :6543，建議加 ?pgbouncer=true&connection_limit=1
# DATABASE_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Migrate deploy：Direct connection :5432
# DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=
DIRECT_URL=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GameFi Phase 1B：Google OAuth 回傳（本機與 Vercel 各設一組；可公開，勿提交密碼）
# 本機範例：
# AUTH_REDIRECT_URL=http://localhost:3000/gamefi/auth/callback
# NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/gamefi/auth/callback
# Production 範例：
# NEXT_PUBLIC_AUTH_REDIRECT_URL=https://wealth-freedom-calculator.vercel.app/gamefi/auth/callback
AUTH_REDIRECT_URL=
NEXT_PUBLIC_AUTH_REDIRECT_URL=
